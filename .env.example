# ==============================================================================
# DOCUMENT VERSION MANAGER - Environment Configuration Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to Git — it is listed in .gitignore.
# ==============================================================================

# Server Configuration
PORT=3000
# Use NODE_ENV=production on your host. In production the server REFUSES to
# simulate OTPs: if no SMS provider is configured, /api/auth/send-otp returns an
# error instead of pretending a message was sent.
NODE_ENV=development

# JWT Secret for fallback custom-provider sessions (32+ random characters)
JWT_SECRET=replace_with_a_strong_random_32_character_secret

# ==============================================================================
# SUPABASE — PRIMARY AUTH PROVIDER (RECOMMENDED)
# ==============================================================================
#
# 1. Go to https://supabase.com and create a free account (no card required).
# 2. Create a new project (takes ~2 minutes to provision).
# 3. Go to Project Settings → API.
# 4. Copy the three values below.
# 5. Go to Authentication → Providers → Phone and enable your SMS provider.
#    Supabase supports: Twilio, MessageBird, Vonage, TextLocal, Twilio Verify.
#    (Twilio trial: free $15 credit — works with Indian numbers via Twilio Verify)
#
# IMPORTANT:
#   SUPABASE_URL and SUPABASE_ANON_KEY are safe to expose to browsers.
#   SUPABASE_SERVICE_ROLE_KEY bypasses RLS — keep it SERVER-SIDE ONLY.
#   Never put SUPABASE_SERVICE_ROLE_KEY in any frontend file.
#
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ==============================================================================
# FALLBACK SMS PROVIDERS
# Used only when Supabase is not configured (SUPABASE_URL is missing or invalid).
# You can also configure these providers directly inside Supabase Dashboard
# under Authentication → Providers → Phone, which is the PREFERRED approach.
# ==============================================================================

# OPTION 1: Fast2SMS (Recommended for India +91 mobile numbers)
# Free instant account, zero card required: https://www.fast2sms.com
# Copy your Dev Authorization Key from: Fast2SMS Dashboard → Dev API
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OPTION 2: Twilio (Recommended for global / international mobile numbers)
# Free $15 trial credit on signup: https://www.twilio.com
# Note: Twilio trial restricts sending to verified numbers only.
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# OPTION 3: 2Factor.in (Indian SMS gateway)
TWO_FACTOR_API_KEY=your_2factor_api_key_here

# ==============================================================================
# FIREBASE (Legacy — can be removed if not used)
# ==============================================================================
FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdefGhIjKlMnOp
FIREBASE_AUTH_DOMAIN=doc-version-manager.firebaseapp.com
FIREBASE_PROJECT_ID=doc-version-manager
FIREBASE_STORAGE_BUCKET=doc-version-manager.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
