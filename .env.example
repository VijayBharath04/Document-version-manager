# ==============================================================================
# DOCUMENT VERSION MANAGER - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for Session Management (Use a strong 32+ character random string in production)
JWT_SECRET=dvm_production_session_jwt_secret_key_2026_scm

# ==============================================================================
# REAL SMS OTP GATEWAYS (Choose one to deliver real SMS to physical mobile phones)
# ==============================================================================

# OPTION 1: Fast2SMS (Recommended for India +91 mobile numbers)
# Free instant account, zero card required: https://www.fast2sms.com
# Copy your Dev Authorization Key from: Fast2SMS Dashboard -> Dev API
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OPTION 2: Twilio (Recommended for Global / International mobile numbers)
# Free $15 trial credit on signup: https://www.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# OPTION 3: 2Factor.in (Indian SMS Gateway with free trial)
TWO_FACTOR_API_KEY=your_2factor_api_key_here

# ==============================================================================
# OPTIONAL: Firebase Authentication (10,000 Free Phone Verifications / Month)
# ==============================================================================
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdefGhIjKlMnOp
FIREBASE_AUTH_DOMAIN=doc-version-manager.firebaseapp.com
FIREBASE_PROJECT_ID=doc-version-manager
FIREBASE_STORAGE_BUCKET=doc-version-manager.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Optional: Supabase Configuration (If using Supabase PostgreSQL for remote DB)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
